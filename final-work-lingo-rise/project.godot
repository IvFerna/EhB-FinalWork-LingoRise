; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FinalWork_LingoRise"
run/main_scene="uid://cjf6upacpp1si"
config/features=PackedStringArray("4.5", "C#", "Mobile")
config/icon="res://assets/icon.svg"

[autoload]

LexiconManager="*res://scripts/autoload/LexiconManager.cs"
RequestSystem="*res://scripts/autoload/RequestSystem.cs"
LocalLexiconRepository="*res://scripts/autoload/LocalLexiconRepository.cs"
AudioManager="*res://scripts/autoload/AudioManager.cs"
VocabularyManager="*res://scripts/autoload/VocabularyManager.cs"
TTSService="*res://scripts/autoload/TTSService.cs"
DialogueManager="*res://scripts/autoload/DialogueManager.cs"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="FinalWork_LingoRise"

[file_customization]

folder_colors={
"res://assets/": "purple",
"res://autoload/": "yellow",
"res://resources/": "orange",
"res://scenes/": "green",
"res://scripts/": "blue"
}

[global_group]

player=""

